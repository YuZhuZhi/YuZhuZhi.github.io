// 所有问答仅在这里维护；页序与幻灯片一致。
#let all-questions = (
  // 01 封面
  (
    (
      question: [这篇论文提出了新的纠错码吗？],
      answer: [没有。它主要解决给定 CSS 码和目标 Clifford 逻辑门之后，怎样求对应物理门序列的问题。],
    ),
    (
      question: [这套方法需要先给出什么输入？],
      answer: [需要 CSS 码的两类稳定子矩阵、选定的逻辑 Pauli 算符，以及目标 Clifford 门对这些逻辑算符的映射。],
    ),
    (
      question: [最后得到的是抽象矩阵还是可执行线路？],
      answer: [两者都有。先求满足约束的二进制辛矩阵，再分解成 H、S、CNOT、SWAP 等物理门。],
