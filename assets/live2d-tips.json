  "seasons": [
    {
      "lunar": "eve",
      "text": "除夕安康，愿旧岁至此圆满，新年灯火可亲。"
    },
    {
      "lunar": "01/01-01/07",
      "text": "春节快乐！愿新岁平安顺遂，所盼皆有回响。"
    },
    {
      "lunar": "01/15",
      "text": "元宵节快乐，愿今夜灯火明亮，月圆人安。"
    },
    {
      "lunar": "02/02",
      "text": "二月二，龙抬头，愿春意苏醒，好运抬头。"
    },
    {
      "lunar": "03/03",
      "text": "上巳春归，愿你临水赏春，心境清明。"
    },
    {
      "lunar": "04/08",
      "text": "浴佛节，愿今日心有慈悲，清净自在。"
    },
    {
      "lunar": "05/05",
      "text": "端午安康，愿粽叶飘香，岁岁无恙。"
    },
    {
      "lunar": "06/06",
      "text": "天贶节，愿盛夏晴明，书卷与衣物都沾一缕阳光。"
    },
    {
      "lunar": "07/07",
      "text": "七夕快乐，愿真心相伴，长久胜过朝夕。"
    },
    {
      "lunar": "07/15",
      "text": "中元时节，愿思念有所寄托，灯火照见归途。"
    },
    {
      "lunar": "08/15",
      "text": "中秋快乐，愿月圆人团圆，千里共清辉。"
    },
    {
      "lunar": "09/09",
      "text": "重阳安康，愿登高见远，也常伴长辈身旁。"
    },
    {
      "lunar": "10/01",
      "text": "寒衣时节，愿思念有归处，牵挂有回声。"
    },
    {
      "lunar": "10/15",
      "text": "下元日，愿消解烦忧，心有所安。"
    },
    {
      "lunar": "12/08",
      "text": "腊八节，愿一碗暖粥驱散寒意，也开启年味。"
    },
    {
      "lunar": "12/23-12/24",
      "text": "小年快乐，扫尘辞旧，静候新春。"
    },
    {
      "date": "01/01",
      "text": "新年快乐！愿 {year} 年有许多值得期待的事。"
    },
    {
      "date": "01/10",
      "text": "中国人民警察节，向守护平安的人们致意。"
    },
    {
      "date": "02/02",
      "text": "世界湿地日，愿水泽常青，万物自在生长。"
    },
    {
      "date": "02/14",
      "text": "情人节快乐，愿每一份真诚的喜欢都有回应。"
    },
    {
      "date": "02/21",
      "text": "国际母语日，愿每一种语言都被听见与珍惜。"
    },
    {
      "date": "03/08",
      "text": "国际妇女节快乐，愿每一位女性自由、从容而闪耀。"
    },
    {
      "date": "03/12",
      "text": "植树节，种下一点绿色，也种下一份长久的期待。"
    },
    {
      "date": "03/14",
      "text": "圆周率日快乐，愿理性与想象力都没有边界。"
    },
    {
      "date": "03/20",
      "text": "国际幸福日，愿今天有细小而确定的快乐。"
    },
    {
      "date": "03/21",
      "text": "世界诗歌日，愿文字替你留住难以言说的心绪。"
    },
    {
      "date": "03/22",
      "text": "世界水日，珍惜每一滴清澈，也珍惜万物的源头。"
    },
    {
      "date": "04/01",
      "text": "愚人节快乐，今天的玩笑也要温柔且有分寸。"
    },
    {
      "date": "04/02",
      "text": "世界孤独症关注日，愿不同的表达都得到理解。"
    },
    {
      "date": "04/04-04/06",
      "text": "清明时节，愿思念有所安放，故人常在心间。"
    },
    {
      "date": "04/07",
      "text": "世界卫生日，照顾好身体，也照顾好自己的心情。"
    },
    {
      "date": "04/16",
      "text": "御伫之，生日快乐！愿新一岁的阳光，刚好晒暖你心里所有柔软的角落。"
    },
    {
      "date": "04/22",
      "text": "世界地球日，愿我们共同珍惜这颗蓝色星球。"
    },
    {
      "date": "04/23",
      "text": "世界读书日，愿你总能在书页间遇见新的世界。"
    },
    {
      "date": "04/26",
      "text": "世界知识产权日，愿每一份创造都得到尊重。"
    },
    {
      "date": "05/01",
      "text": "劳动节快乐，今天也要记得休息。"
    },
    {
      "date": "05/04",
      "text": "青年节快乐，愿热望不息，脚步坚定而明亮。"
    },
    {
      "date": "05/08",
      "text": "世界红十字日，向每一份跨越边界的善意致意。"
    },
    {
      "date": "05/12",
      "text": "国际护士节，感谢每一位守护生命与健康的人。"
    },
    {
      "date": "05/15",
      "text": "国际家庭日，愿理解与陪伴常在家人之间。"
    },
    {
      "date": "05/18",
      "text": "国际博物馆日，去与时间、文明和故事相遇吧。"
    },
    {
      "date": "05/20",
      "text": "今天适合认真表达喜欢，也适合好好爱自己。"
    },
    {
      "date": "05/22",
      "text": "国际生物多样性日，愿万千生命共享丰饶家园。"
    },
    {
      "date": "06/01",
      "text": "儿童节快乐，愿你一直保留好奇、勇气与天真。"
    },
    {
      "date": "06/05",
      "text": "世界环境日，让每一个小小选择都对地球更友好。"
    },
    {
      "date": "06/06",
      "text": "全国爱眼日，读得投入，也别忘了让眼睛休息。"
    },
    {
      "date": "06/08",
      "text": "世界海洋日，愿蔚蓝辽阔，鲸歌长存。"
    },
    {
      "date": "06/14",
      "text": "世界献血者日，感谢每一份为生命伸出的援手。"
    },
    {
      "date": "06/21",
      "text": "世界音乐日，愿今天有一段旋律恰好与你共鸣。"
    },
    {
      "date": "06/23",
      "text": "国际奥林匹克日，愿运动带来力量、友谊与快乐。"
    },
    {
      "date": "06/26",
      "text": "国际禁毒日，珍爱生命，远离毒品。"
    },
    {
      "date": "07/01",
      "text": "七月的第一天，愿新的月份有明朗的开始。"
    },
    {
      "date": "07/11",
      "text": "世界人口日，愿每个人的尊严与选择都被尊重。"
    },
    {
      "date": "08/01",
      "text": "建军节，向守护和平与安宁的人们致敬。"
    },
    {
      "date": "08/08",
      "text": "全民健身日，起来活动一下，让身体舒展开来吧。"
    },
    {
      "date": "08/12",
      "text": "国际青年日，愿年轻的声音勇敢而清晰。"
    },
    {
      "date": "08/19",
      "text": "世界人道主义日，向身处险境仍帮助他人的人致意。"
    },
    {
      "date": "09/03",
      "text": "铭记历史，珍爱和平，愿世界长久安宁。"
    },
    {
      "date": "09/05",
      "text": "中华慈善日，愿善意汇流，抵达真正需要的地方。"
    },
    {
      "date": "09/08",
      "text": "国际扫盲日，愿知识的大门向每个人敞开。"
    },
    {
      "date": "09/10",
      "text": "教师节快乐，感谢每一位点亮求知道路的老师。"
    },
    {
      "date": "09/18",
      "text": "铭记历史，珍惜来之不易的和平。"
    },
    {
      "date": "09/21",
      "text": "国际和平日，愿理解胜过隔阂，交流化解纷争。"
    },
    {
      "date": "09/27",
      "text": "世界旅游日，愿每一次出发都带来新的眼界。"
    },
    {
      "date": "10/01-10/07",
      "text": "国庆假期快乐！愿你有一段轻松的时间。"
    },
    {
      "date": "10/04",
      "text": "世界动物日，愿所有生命都被温柔对待。"
    },
    {
      "date": "10/10",
      "text": "世界精神卫生日，疲惫时也请允许自己停下来。"
    },
    {
      "date": "10/16",
      "text": "世界粮食日，珍惜食物，也感谢每一份辛勤耕耘。"
    },
    {
      "date": "10/24",
      "text": "联合国日，愿合作与对话让世界更加接近。"
    },
    {
      "date": "10/31",
      "text": "万圣夜快乐，愿今晚有一点奇妙而无害的惊喜。"
    },
    {
      "date": "11/09",
      "text": "全国消防日，留意消防安全，也向逆行者致敬。"
    },
    {
      "date": "11/11",
      "text": "愿今天不只是购物清单，也有对自己的认真关照。"
    },
    {
      "date": "11/17",
      "text": "国际大学生节，愿求知的热情始终鲜活。"
    },
    {
      "date": "11/20",
      "text": "世界儿童日，愿每个孩子都被保护、倾听与尊重。"
    },
    {
      "date": "11/21",
      "text": "世界问候日，向遇见的人送上一句真诚的你好。"
    },
    {
      "date": "12/01",
      "text": "世界艾滋病日，了解、尊重，不恐惧也不歧视。"
    },
    {
      "date": "12/03",
      "text": "国际残疾人日，愿无障碍不止于设施，也存在于理解。"
    },
    {
      "date": "12/05",
      "text": "国际志愿者日，感谢每一份不求回报的付出。"
    },
    {
      "date": "12/10",
      "text": "世界人权日，愿尊严、自由与平等属于每一个人。"
    },
    {
      "date": "12/13",
      "text": "铭记历史，悼念逝者，珍爱和平。"
    },
    {
      "date": "12/20",
      "text": "澳门回归纪念日，愿濠江灯火常明，明天更加美好。"
    },
    {
      "date": "12/21-12/23",
      "text": "冬至已至，愿这个漫长的夜晚温暖而安宁。"
    },
    {
      "date": "12/24-12/25",
      "text": "愿这个冬日的节日温暖而明亮。"
    },
    {
      "date": "12/31",
      "text": "今天是 {year} 年的最后一天，认真和这一年道别吧。"
    }
